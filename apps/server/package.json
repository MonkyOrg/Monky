{
  "name": "@monky/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "monky": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-migrations.js",
    "dev": "node scripts/copy-migrations.js && tsc --watch",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "test": "node dist/test-server.js && node --test dist/test-bots.js dist/test-online-preview.js dist/test-voice.js dist/test-voice-mode.js",
    "test:bots": "node --test dist/test-bots.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@monky/shared": "*",
    "mediasoup": "^3.26.0",
    "sql.js": "^1.12.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3"
  }
}
