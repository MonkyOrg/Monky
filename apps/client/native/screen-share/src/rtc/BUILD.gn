import("//build/config/c++/c++.gni")
import("//webrtc.gni")

assert(((is_win && target_cpu == "x64") ||
        (is_mac && (target_cpu == "arm64" || target_cpu == "x64"))) &&
       is_clang && use_custom_libcxx)
assert(!is_component_build && !is_debug)

config("monky_screen_options") {
  include_dirs = [
    "inputs/abi",
    "inputs/adapters",
    "inputs/engine",
    "inputs/native_core",
    "inputs/libmediasoupclient/include",
    "inputs/libsdptransform/include",
  ]
  if (is_win) {
    defines = [ "WEBRTC_WIN", "NOMINMAX", "WIN32_LEAN_AND_MEAN" ]
  } else {
    defines = [ "WEBRTC_MAC", "WEBRTC_POSIX" ]
  }
}

if (is_mac) {
  rtc_library("monky_mac_rtc_adapters") {
    sources = [
      "inputs/adapters/codec_policy.cc",
      "inputs/adapters/mac_rtc_adapters.mm",
      "inputs/native_core/h264_bitstream.cc",
      "../mac/videoDecoder.mm",
    ]
    include_dirs = [ "../mac" ]
    cflags_objcc = [ "-fobjc-arc" ]
    suppressed_configs = [ "//build/config/compiler:no_exceptions", "//build/config/compiler:no_rtti" ]
    configs += [ "//build/config/compiler:exceptions", "//build/config/compiler:rtti", ":monky_screen_options" ]
    public_configs = [ ":monky_screen_options" ]
    frameworks = [ "Foundation.framework", "CoreVideo.framework", "CoreMedia.framework",
                   "VideoToolbox.framework", "IOSurface.framework" ]
    deps = [
      "//api:make_ref_counted", "//api:scoped_refptr", "//api/video:video_frame",
      "//api/video_codecs:video_codecs_api", "//common_video", "//third_party/libyuv",
      "//modules/video_coding:video_codec_interface",
    ]
  }
}

rtc_shared_library("monky_av1") {
  sources = [ "inputs/abi/monky_av1.cc" ]
  defines = [ "MONKY_AV1_BUILD" ]
  suppressed_configs = [ "//build/config/compiler:no_exceptions" ]
  configs += [ "//build/config/compiler:exceptions", ":monky_screen_options" ]
  deps = [ "//third_party/libaom", "//third_party/dav1d" ]
  if (is_mac) {
    ldflags = [ "-Wl,-install_name,@rpath/libmonky_av1.dylib" ]
  }
}

rtc_library("monky_sdptransform") {
  sources = [
    "inputs/libsdptransform/src/grammar.cpp",
    "inputs/libsdptransform/src/parser.cpp",
    "inputs/libsdptransform/src/writer.cpp",
  ]
  suppressed_configs = [
    "//build/config/compiler:no_exceptions",
    "//build/config/compiler:no_rtti",
  ]
  configs += [
    "//build/config/compiler:exceptions",
    "//build/config/compiler:rtti",
    ":monky_screen_options",
  ]
  public_configs = [ ":monky_screen_options" ]
}

rtc_library("monky_mediasoupclient") {
  sources = [
    "inputs/libmediasoupclient/src/Consumer.cpp",
    "inputs/libmediasoupclient/src/DataConsumer.cpp",
    "inputs/libmediasoupclient/src/DataProducer.cpp",
    "inputs/libmediasoupclient/src/Device.cpp",
    "inputs/libmediasoupclient/src/Handler.cpp",
    "inputs/libmediasoupclient/src/Logger.cpp",
    "inputs/libmediasoupclient/src/Producer.cpp",
    "inputs/libmediasoupclient/src/Transport.cpp",
    "inputs/libmediasoupclient/src/mediasoupclient.cpp",
    "inputs/libmediasoupclient/src/ortc.cpp",
    "inputs/libmediasoupclient/src/scalabilityMode.cpp",
    "inputs/libmediasoupclient/src/sdp/MediaSection.cpp",
    "inputs/libmediasoupclient/src/sdp/RemoteSdp.cpp",
    "inputs/libmediasoupclient/src/sdp/Utils.cpp",
  ]
  suppressed_configs = [
    "//build/config/compiler:no_exceptions",
    "//build/config/compiler:no_rtti",
  ]
  configs += [
    "//build/config/compiler:exceptions",
    "//build/config/compiler:rtti",
    ":monky_screen_options",
  ]
  public_configs = [ ":monky_screen_options" ]
  deps = [
    ":monky_sdptransform",
    "//api:create_peerconnection_factory",
    "//api:libjingle_peerconnection_api",
    "//api/video_codecs:video_codecs_api",
    "//media:rtc_media_base",
  ]
}

rtc_library("monky_qualified_mf_core") {
  sources = [
    "inputs/native_core/decoded_frame.cc",
    "inputs/native_core/h264_bitstream.cc",
    "inputs/native_core/mf_h264_decoder.cc",
    "inputs/native_core/mf_h264_encoder.cc",
  ]
  suppressed_configs = [
    "//build/config/compiler:no_exceptions",
    "//build/config/compiler:no_rtti",
  ]
  configs += [
    "//build/config/compiler:exceptions",
    "//build/config/compiler:rtti",
    ":monky_screen_options",
  ]
  public_configs = [ ":monky_screen_options" ]
  libs = [
    "d3d11.lib",
    "dxgi.lib",
    "dxguid.lib",
    "d3dcompiler.lib",
    "mfplat.lib",
    "mfuuid.lib",
    "strmiids.lib",
    "windowsapp.lib",
    "runtimeobject.lib",
    "ole32.lib",
    "oleaut32.lib",
    "user32.lib",
    "uuid.lib",
    "delayimp.lib",
  ]
}

rtc_library("monky_mf_rtc_adapters") {
  sources = [
    "inputs/adapters/codec_policy.cc",
    "inputs/adapters/mf_rtc_common.cc",
    "inputs/adapters/mf_rtc_policy.cc",
    "inputs/adapters/mf_rtc_encoder.cc",
    "inputs/adapters/mf_rtc_decoder.cc",
  ]
  suppressed_configs = [
    "//build/config/compiler:no_exceptions",
    "//build/config/compiler:no_rtti",
  ]
  configs += [
    "//build/config/compiler:exceptions",
    "//build/config/compiler:rtti",
    ":monky_screen_options",
  ]
  public_configs = [ ":monky_screen_options" ]
  deps = [
    ":monky_qualified_mf_core",
    "//api:make_ref_counted",
    "//api:rtp_packet_info",
    "//api:scoped_refptr",
    "//api/environment:environment",
    "//api/environment:environment_factory",
    "//api/video:video_frame",
    "//api/video_codecs:video_codecs_api",
    "//modules/video_coding:video_codec_interface",
  ]
}

rtc_shared_library("monky_screen_rtc") {
  output_name = "monky_screen_rtc"
  sources = [
    "inputs/engine/engine.cc",
  ]
  if (is_win) {
    sources += [ "inputs/abi/rtc_link_probe.cc", "inputs/abi/adapter_policy_probe.cc" ]
  }
  defines = [ "MONKY_RTC_BUILDING_DLL" ]
  suppressed_configs = [
    "//build/config/compiler:no_exceptions",
    "//build/config/compiler:no_rtti",
  ]
  configs += [
    "//build/config/compiler:exceptions",
    "//build/config/compiler:rtti",
    ":monky_screen_options",
  ]
  if (is_win) {
    ldflags = [ "/DELAYLOAD:mfplat.dll", "/threads:4" ]
  } else {
    ldflags = [ "-Wl,-install_name,@rpath/libmonky_screen_rtc.dylib" ]
  }
  deps = [
    ":monky_mediasoupclient",
    ":monky_rtc_engine_core",
    ":monky_sdptransform",
    "//api:create_peerconnection_factory",
    "//api:libjingle_peerconnection_api",
    "//rtc_base:ssl",
    "//modules/video_coding/codecs/av1:dav1d_decoder",
    "//third_party/dav1d",
    "//third_party/libyuv",
  ]
  if (is_win) {
    deps += [ ":monky_mf_rtc_adapters", ":monky_qualified_mf_core" ]
  } else {
    deps += [ ":monky_mac_rtc_adapters" ]
  }
}

rtc_library("monky_rtc_engine_core") {
  sources = [
    "inputs/engine/capture_clock.cc",
    "inputs/engine/audio/pcm_normalizer.cc",
    "inputs/engine/audio/pcm_track_source.cc",
    "inputs/engine/audio/capture_timestamp.cc",
    "inputs/engine/audio/credit_audio_device.cc",
    "inputs/engine/audio/output_clock.cc",
    "inputs/engine/audio/runtime.cc",
    "inputs/engine/encoded_video.cc",
    "inputs/engine/peer_controller.cc",
    "inputs/engine/sfu_controller.cc",
    "inputs/engine/transport_parameters.cc",
  ]
  if (is_win) {
    sources += [ "inputs/engine/gpu_source.cc", "inputs/engine/presentation/exporter.cc" ]
  } else {
    sources += [ "inputs/engine/presentation/mac_exporter.mm" ]
    cflags_objcc = [ "-fobjc-arc" ]
    frameworks = [ "Foundation.framework", "CoreVideo.framework", "IOSurface.framework" ]
  }
  suppressed_configs = [
    "//build/config/compiler:no_exceptions",
    "//build/config/compiler:no_rtti",
  ]
  configs += [
    "//build/config/compiler:exceptions",
    "//build/config/compiler:rtti",
    ":monky_screen_options",
  ]
  public_configs = [ ":monky_screen_options" ]
  deps = [
    ":monky_mediasoupclient",
    "//api:field_trials",
    "//api:libjingle_peerconnection_api",
    "//api:make_ref_counted",
    "//api:rtc_stats_api",
    "//api/audio:create_audio_device_module",
    "//api/audio_codecs:audio_codecs_api",
    "//api/audio_codecs/opus:audio_decoder_opus",
    "//api/audio_codecs/opus:audio_encoder_opus",
    "//api/environment:environment_factory",
    "//api/video:video_frame",
    "//api/video:video_rtp_headers",
    "//common_audio",
    "//media:video_broadcaster",
    "//modules/video_coding:video_codec_interface",
    "//pc:session_description",
    "//modules/video_coding/svc:scalability_structures",
    "//third_party/dav1d",
    "//pc:video_track_source",
    "//rtc_base:logging",
    "//rtc_base:timestamp_aligner",
    "//rtc_base:threading",
    "//stats:rtc_stats",
  ]
  if (is_win) {
    deps += [ ":monky_mf_rtc_adapters" ]
  } else {
    deps += [ ":monky_mac_rtc_adapters" ]
  }
}

group("all") {
  deps = [ ":monky_screen_rtc", ":monky_av1" ]
  if (is_win) {
    deps += [ ":monky_msvc_job", ":monky_rtc_engine_contract_probe" ]
  }
}

rtc_executable("monky_rtc_engine_contract_probe") {
  sources = [
    "inputs/engine/contract_probe.cc",
    "inputs/abi/adapter_policy_probe.cc",
  ]
  suppressed_configs = [
    "//build/config/compiler:no_exceptions",
    "//build/config/compiler:no_rtti",
  ]
  configs += [
    "//build/config/compiler:exceptions",
    "//build/config/compiler:rtti",
    ":monky_screen_options",
  ]
  deps = [
    ":monky_rtc_engine_core",
    "//api:field_trials_view",
    ":monky_av1",
    "//third_party/dav1d",
    "//api:rtc_stats_api",
    "//api/task_queue:task_queue",
    "//api/video:video_frame",
    "//call:video_receive_stream_api",
    "//modules/video_coding:video_codec_interface",
    "//modules/video_coding:video_coding",
    "//modules/video_coding/timing:timing_module",
    "//rtc_base:logging",
    "//stats:rtc_stats",
    "//system_wrappers:system_wrappers",
    "//video:video",
    "//video:video_stream_buffer_controller",
  ]
  ldflags = [
    "/DELAYLOAD:mfplat.dll",
    "/threads:4",
  ]
}

rtc_executable("monky_msvc_job") {
  sources = [ "inputs/build/msvc_job.cc" ]
  deps = []
  suppressed_configs = [
    "//build/config/compiler:no_exceptions",
    "//build/config/compiler:no_rtti",
  ]
  configs += [
    "//build/config/compiler:exceptions",
    "//build/config/compiler:rtti",
  ]
  ldflags = [ "/threads:4" ]
}
