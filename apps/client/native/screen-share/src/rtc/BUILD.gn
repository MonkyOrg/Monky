    "inputs/abi",
    "inputs/adapters",
    "inputs/engine",
    "inputs/native_core",
    "inputs/libmediasoupclient/include",
    "inputs/libsdptransform/include",
  ]
  defines = [
    "WEBRTC_WIN",
    "NOMINMAX",
    "WIN32_LEAN_AND_MEAN",
  ]
}

