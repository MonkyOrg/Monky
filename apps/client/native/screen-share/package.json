{
  "name": "@monky/screen-share",
  "version": "1.0.0",
  "private": true,
  "description": "Owned native screen capture, transport and presentation for Monky",
  "license": "GPL-3.0-or-later",
  "main": "index.cjs",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.cjs" },
    "./renderer": { "types": "./renderer.d.ts", "default": "./renderer.cjs" },
    "./runtime/*": "./runtime/*",
    "./package.json": "./package.json"
  },
  "files": ["index.cjs", "index.d.ts", "renderer.cjs", "renderer.d.ts", "runtime", "bin", "licenses", "LICENSE", "THIRD_PARTY_NOTICES", "README.md", "README.en.md"],
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "test:capture": "node test/nativeCaptureSmoke.cjs"
  },
  "dependencies": {
    "@monky/shared": "*"
  }
}
