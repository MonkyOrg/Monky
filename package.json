{
  "name": "monky",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monky — P2P Self-Hosted Voice, Video, Screen Share and Chat Application",
  "repository": {
    "type": "git",
    "url": "https://github.com/MonkyOrg/Monky.git"
  },
  "bugs": {
    "url": "https://github.com/MonkyOrg/Monky/issues"
  },
  "funding": "https://buymeacoffee.com/monkyorg",
  "homepage": "https://github.com/MonkyOrg/Monky#readme",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=apps/client",
    "app": "npm run start --workspace=apps/client",
    "package": "npm run build && node scripts/package.js",
    "dist": "npm run build && node scripts/package.js",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:client": "npm run dev --workspace=apps/client",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=packages/bot-sdk && npm run build --workspace=apps/server && npm run build --workspace=apps/client",
    "build:server": "npm run build --workspace=packages/shared && npm run build --workspace=apps/server",
    "pack:cli": "npm run build && node scripts/pack-cli.js",
    "test": "node scripts/test-versioning.js && node scripts/test-changelog.js && npm run test --workspaces",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site"
  },
  "keywords": [
    "webrtc",
    "p2p",
    "voice",
    "electron",
    "self-hosted",
    "chat"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "mermaid": "^11.17.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
